(function(){
  const GEN = 'https://docs.google.com/document/d/19CriQtdbtUAPRinkzT_X6l-laijLck6t_G2sjUWnysk/edit?usp=sharing';
  const GROUND = 'https://docs.google.com/document/d/1mP658jNNIeouNwcvjBCzhewrfFuaxJMUQjEjwfa2BVk/edit?usp=sharing';
  const PEG = 'https://liberationworkshops.com/liberation-childhood-experience-workshops/';
  const R = {
    T:['Tria','Lead Facilitator and Vision','Program, facilitation, budget, pricing, final say on content','Prices, sales page, emails, applicant acceptance'],
    L:['Laila','Marketing and Project Lead','Timeline, Trello, check-ins, campaign, content, website and forms, this SOP','Drafts go to Tria for approval'],
    O:['Organizer','Local Organizer (per event, e.g. Olga)','Venue, local vendors, ground team, participant logistics and questions','Venue and vendor details'],
    C:['Co-facilitator','Co-facilitator (per event)','Co-facilitation, shared content, personal outreach','Their own content'],
    U:['Ground team','Ground team and assistants','On-site setup, check-in, meals, tech, photos with consent','']
  };
  const NAME = {T:'Tria',L:'Laila',O:'Organizer',C:'Co-facilitator',U:'Ground team',A:'Everyone'};
  const esc = s => s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const pill = k => `<span class="pill" style="--c:var(--r-${k})">${NAME[k]}</span>`;
  // a task's text may carry one link: [text, owners, {href,label}]
  const taskHtml = ([txt,o,link]) => `<li><div class="task">${esc(txt)}${link?` <a href="${link.href}" target="_blank" rel="noopener">${esc(link.label)} ↗</a>`:''}<div class="owners">${[...o].map(pill).join('')}</div></div></li>`;

  document.getElementById('roles-body').innerHTML = Object.entries(R).map(([k,r]) =>
    `<tr><td>${esc(r[1])}</td><td>${pill(k)}</td><td>${esc(r[2])}</td><td>${esc(r[3]||'—')}</td></tr>`).join('');

  const S = [
    {id:'s1', name:'Foundation', when:'9 to 6 months before', lead:'Laila', short:'Venue signed, prices approved, form tested',
     lede:"Foundation sets the event's base: what it is, where, for whom, at what price, and who does what. Nothing is promoted until this stage is done.",
     groups:[
      ['Team',[['Confirm the team for this event, including the local organizer and any co-facilitator','L'],['Set up the Trello board, WhatsApp group and Drive folder for the event','L'],['Book a weekly or biweekly check-in for the whole run','L']]],
      ['Concept and program',[['Fill in the event basics:','TL',{href:GEN,label:'General Checklist'}],["Define the theme, who it's for, who it's not for, and the outcomes we can honestly describe",'T'],['Draft the program flow: daily arc, rituals, teaching, movement and integration','T'],['Check it against the brand values: integrity, embodiment, devotion, growth and community','T']]],
      ['Venue and logistics',[['Choose and secure the venue: contract, deposit, permits, dates, check-in and check-out times','O'],['List equipment needs: massage tables, mats, linens, sound system, projector','O'],['Line up local vendors and support: transport, catering, photographer','O']]],
      ['Budget and pricing',[['Draft the budget: venue, catering, travel, team stipends, marketing and ads','TO'],['Set price tiers and their deadlines, such as Early Bird and Standard','T'],['Agree organizer and facilitator splits in writing','TO'],['Write the refund, transfer and cancellation policy','TO'],['Set the minimum number of participants needed to run the event','T']]],
      ['Marketing setup',[['Write the campaign plan and content calendar, working back from the event dates','L'],['Create event branding using the approved brand assets: theme, tagline, banners, graphics','L'],["Write the sales page copy: dates, location, who it's for, pricing, how to apply (Tria approves)",'L'],['Add the event card to the events page, following the','L',{href:PEG,label:'event page model'}],['Install tracking, such as the Meta pixel, before any ads run','L']]],
      ['Registration system',[['Build the application form and payment flow (Fastpay / link.templesomatics.com)','L'],['Test the full flow end to end: apply, confirmation email, acceptance, payment','L'],['Decide the application rules: who reviews, the 5 to 7 day reply promise, deposit and payment plan terms','T']]]
     ],
     done:'The venue contract is signed, prices and policies are approved by Tria, and the sales page and application form are live and tested.'},
    {id:'s2', name:'Invitation', when:'6 months to 3 or 4 weeks before', lead:'Laila', short:'Applications closed, group at or above minimum',
     lede:'Invitation is where we find and welcome the right people. It runs from the day applications open until they close, and builds toward two deadlines: the early-bird date and the application close.',
     groups:[
      ['Marketing, in order of what fills seats',[['Personal invitations: each person lists 15 to 20 people who fit and reaches out one to one (Laila tracks)','TCO'],['Email about once a week, mostly teaching and stories with clear dates; drafted a week ahead, approved within 2 to 3 days','L'],["Communities: WhatsApp groups, ISTA and partner networks, schools and newsletters, after checking each group's rules (Laila writes the messages)",'OT'],['Local promotion as enrollment partner: own networks, flyers, Facebook events, answering inquiries with the FAQ','O'],['Instagram: about one Reel and one post a week, plus stories and collab posts with the co-facilitator','L'],['Ads, if used: send them to the free video training, not straight to the application; test wording first, since Meta restricts some sexual wellness language','L'],['Push hardest in the two weeks before each deadline','L']]],
      ['Content from Tria',[['Record in batch sessions of about 60 minutes, one every 4 to 5 weeks (Laila sends the outline)','T'],['Write and record joint content with the co-facilitator in their own words (Laila edits)','TC']]],
      ['Applications',[['Review applications on a rolling basis and reply within 5 to 7 days','T'],['Log every application in the participant tracker: status, payment, notes','L'],['Send acceptance emails with the official payment link and deadline','L'],["Follow up personally with anyone who applied but hasn't paid",'O']]],
      ['Go/no-go check, 10 weeks before',[['Compare accepted, paid participants with the minimum set in Foundation','L'],['If below the minimum, decide: extend the push, change the format, or move or cancel the event','T']]]
     ],
     rules:['Only confirmed dates, prices, program details and testimonials.','No promises of healing outcomes.','Sexuality and eros are described with care and context, as on the website, never as a hook.','Every post, email and message ends with one clear action: apply.'],
     done:'Applications close and the group is confirmed at or above the minimum.'},
    {id:'s3', name:'Preparation', when:'8 to 1 weeks before', lead:'Laila, with the organizer', short:'Everyone paid or on a plan, letter sent',
     lede:'Preparation turns a confirmed group into a ready event. It overlaps with the end of Invitation and covers logistics, payments, participant onboarding and the final program.',
     groups:[
      ['Team',[['Hold weekly check-ins and keep Trello up to date','L'],['Confirm the ground team: assistants, photographer, logistics help','O'],['Share the checklist with the organizer and ground team:','O',{href:GROUND,label:'Ground Team Checklist'}]]],
      ['Venue and logistics',[['Confirm the venue layout: teaching space, dining area, altars, banners','O'],['Finalize rooms and catering, with the final headcount for meals and lodging','O'],['Confirm supplies: mats, linens, water station, candles, art materials, ritual tools','O'],['List participants who need transport and coordinate pickups','O']]],
      ['Payments',[['Finalize supplier contracts and pay deposits','O'],['Send payment reminders and balance-due emails with the official payment link','L'],['Check the refund and cancellation policy is visible on the registration pages','L']]],
      ['Participant onboarding',[['Keep the participant tracker current: confirmed, deposit only, fully paid','L'],['Send the pre-arrival letter: arrival time, travel tips, packing list, what to expect (Tria approves)','O'],['Use message templates for fully paid participants and for deposit holders who need a follow-up','L'],['Collect dietary, health and emergency contact details, if not already on the application','O'],['Open the private participant group (WhatsApp or Instagram)','O']]],
      ['Program',[['Finalize the daily program: sessions, meals, breaks, rituals','T'],['Run a facilitator walk-through and a tech check','TC'],['Prepare the retreat manual or printed materials, if any','L'],['Build and test the post-event feedback form','L']]],
      ['Marketing',[['Post countdown content and behind-the-scenes preparation','L'],['Plan event-week content with Tria, including which moments can be filmed, with participant consent','L']]]
     ],
     done:'Every participant has paid or has an agreed plan, the pre-arrival letter is sent, and the daily program is final.'},
    {id:'s4', name:'Facilitation', when:'Arrival day to closing day', lead:'Tria for the program, the organizer for operations', short:'Closing circle complete',
     lede:"Facilitation is the event itself. The team's job is to keep logistics invisible, so Tria and the co-facilitator can hold the space and participants feel safe and cared for.",
     groups:[
      ['Before arrival day',[['Check the participant list against arrival times','O'],['Send a final reminder: meeting point, arrival window, packing list','O'],['Set up the venue: altar, lighting, sound, mats and tables, technical gear','OU']]],
      ['Each day',[['Morning and evening team check-ins','T'],['Run the day with the','U',{href:GROUND,label:'Ground Team Checklist'}],['Check sound, music and slides before each session','U'],['Support facilitators with timing and transitions','U'],['Make sure meals and drinks are ready on time, and dietary needs are met','OU'],['Watch participant wellbeing and emotional safety, with a named person for logistical or emotional emergencies','T'],['Keep a short log of key moments and changes, for the debrief','O'],['Capture photos or video only where participants have agreed','U']]],
      ['Operations',[['Welcome and check in participants, and help with rooms','OU'],['Remind anyone with a balance to pay through the official link; never accept payment by hand','O'],['Settle on-site supplier balances and record facilitator and organizer payments in the shared tracker','O'],['Keep in clear contact with venue staff','O']]]
     ],
     done:'The closing circle is complete and participants have checked out.'},
    {id:'s5', name:'Integration', when:'Within 2 weeks after', lead:'Laila', short:'Debrief held, SOP updated',
     lede:'Integration completes the cycle: thank people, learn from the event, and invite participants to their next step, such as the Practitioner Program.',
     groups:[
      ['Participants',[['Send the feedback survey within 3 days','L'],["Ask for testimonials, with clear permission for how they're used",'L'],['Update the participant database with contact details and notes','L'],['Tag participants in the CRM for future offers, such as Immersion to Practitioner Program','L'],['Follow up one to one with participants who showed interest in going deeper','T']]],
      ['Marketing',[['Share highlight photos or short videos, only with participant consent','L'],['Post a thank-you on social media','L'],["Send a newsletter celebrating the event and saying what's next (Tria approves)",'L'],['Open a waitlist for the next event and update the event card','L']]],
      ['Logistics and payments',[['Take stock of supplies and store them','O'],['Return rented items, and check ingress and egress with the venue','O'],['Check the venue for damage and recover deposits','O'],['Close the budget: actual spend against plan','TO']]],
      ['Team debrief',[['Hold a 60 to 90 minute debrief with facilitators and team','L'],['Celebrate wins, name challenges, and list improvements','A'],['Send thank-you messages to the venue, vendors and collaborators','O'],['Update this SOP and its templates with what we learned','L']]]
     ],
     done:'The debrief is held, the budget is closed and this SOP is updated.'}
  ];

  document.getElementById('stepper').innerHTML = S.map((s,i) =>
    `<a class="step" href="#${s.id}"><span class="num">${i+1}</span><b>${s.name}</b><span class="when">${s.when}</span><span class="gate">${s.short}</span></a>`).join('');

  document.getElementById('stages').innerHTML = S.map((s,i) => `
    <section id="${s.id}" class="rv">
      <div class="sec-head"><span class="num" aria-hidden="true">${i+1}</span><div><div class="eyebrow">Stage ${i+1}</div><h2>${s.name}</h2></div></div>
      <p class="lede">${esc(s.lede)}</p>
      <div class="chips"><span class="chip"><b>When</b> ${esc(s.when)}</span><span class="chip"><b>Lead</b> ${esc(s.lead)}</span></div>
      <div class="groups">${s.groups.map(([t,items]) => `
        <div class="card"><h3>${esc(t)}</h3><ul>${items.map(taskHtml).join('')}</ul></div>`).join('')}
      </div>
      ${s.rules ? `<div class="rules"><h3>Brand rules for everything we publish</h3><ul>${s.rules.map(r=>`<li>${esc(r)}</li>`).join('')}</ul></div>` : ''}
      <div class="gatebox"><span class="dia" aria-hidden="true"></span><div><b>Done when</b>${esc(s.done)}</div></div>
    </section>`).join('');

  // gentle reveal for sections below the first screen; content stays readable while it settles
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const secs = [...document.querySelectorAll('section.rv')];
  if (!reduce && 'IntersectionObserver' in window) {
    const vh = window.innerHeight || 800;
    secs.forEach(el => { if (el.getBoundingClientRect().top > vh) el.classList.add('pre'); });
    const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.remove('pre'); io.unobserve(e.target); } }), {rootMargin:'0px 0px -8% 0px'});
    secs.forEach(el => io.observe(el));
  }
  // highlight the current section in the sticky menu
  const links = [...document.querySelectorAll('#toc a')];
  if ('IntersectionObserver' in window) {
    const spy = new IntersectionObserver(es => es.forEach(e => {
      if (e.isIntersecting) links.forEach(a => a.classList.toggle('on', a.getAttribute('href') === '#' + e.target.id));
    }), {rootMargin:'-40% 0px -55% 0px'});
    secs.forEach(el => spy.observe(el));
  }
})();
</script>

</body></html>
